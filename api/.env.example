# Copia este archivo como .env y llena los valores vacíos.
# Este archivo SÍ se sube a git: nunca pongas aquí contraseñas ni credenciales reales.

# ========================================
# Servidor
# ========================================
# development activa el log de SQL en la consola (ver config/db.js)
NODE_ENV=development
PORT=3000
BACKEND_URL=http://localhost:3000

# ========================================
# Frontend (enlaces en los emails)
# ========================================
# Sin "/" al final: los enlaces se arman como FRONTEND_URL/confirmar/<token>
FRONTEND_URL=http://localhost:5173

# ========================================
# Base de datos (MySQL)
# ========================================
MYSQL_BD_HOST=localhost
MYSQL_BD_PORT=3306
MYSQL_BD_NAME=reservaya
MYSQL_BD_USER=
MYSQL_BD_PASSWORD=

# ========================================
# Email (Mailtrap · Email Testing → Inboxes → SMTP Settings)
# ========================================
# Cada quien usa las credenciales de su propio inbox de Mailtrap
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASS=
